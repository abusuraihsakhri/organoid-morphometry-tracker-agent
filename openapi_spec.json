{
  "openapi": "3.1.0",
  "info": {
    "title": "Organoid Metric Screening API",
    "description": "Rule-based evaluation of synthetic specimen metrics; not image morphometry or clinical validation.",
    "version": "3.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Browser interface",
        "responses": {
          "200": {
            "description": "HTML"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "JSON health"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters",
        "responses": {
          "200": {
            "description": "Counters"
          }
        }
      }
    },
    "/metrics/prometheus": {
      "get": {
        "summary": "Prometheus counters",
        "responses": {
          "200": {
            "description": "Plain text"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Screen numeric metrics",
        "responses": {
          "200": {
            "description": "Evaluation dossier"
          },
          "400": {
            "description": "Potential identifier"
          },
          "401": {
            "description": "Authorization required when configured"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock supervisory response",
        "responses": {
          "200": {
            "description": "Mock reply"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit headers",
        "responses": {
          "200": {
            "description": "Audit metadata"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Enabled when AUDIT_API_TOKEN is configured"
      }
    }
  }
}
